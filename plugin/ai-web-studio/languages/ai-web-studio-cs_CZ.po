msgstr "Zadejte platnou barvu, například #2563eb."

msgid "Complete all settings fields."
msgstr "Vyplňte všechna pole nastavení."

msgid "Only an administrator with permission to insert code can change these settings."
msgstr "Toto nastavení může změnit pouze správce s oprávněním vkládat kód."

