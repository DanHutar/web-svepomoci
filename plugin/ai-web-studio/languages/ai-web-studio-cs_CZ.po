msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: cs_CZ\nPlural-Forms: nplurals=3; plural=(n == 1) ? 0 : (n >= 2 && n <= 4) ? 1 : 2;\n"

msgid "Use this image"
msgstr "Použít tento obrázek"

msgid "Choose a sharing image"
msgstr "Vybrat obrázek pro sdílení"

msgid "The media library did not load. Reload the page or paste the image URL directly into the field."
msgstr "Knihovna médií se nenačetla. Obnovte stránku; případně vložte adresu obrázku přímo do pole."

msgid "Preview refreshed, but custom code is disabled. Enable it and save the page."
msgstr "Náhled byl obnoven, ale použití vlastního kódu je vypnuté. Zapněte ho a stránku uložte."

msgid "Preview refreshed. Save the page to apply changes to the website."
msgstr "Náhled byl obnoven. Pro zobrazení změn na webu stránku uložte."

msgid "\"><title>Content preview</title>"
msgstr "\"><title>Náhled obsahu</title>"

msgid "”. Assign a menu with links in Appearance → Menus, save it and reload this editor.</p>"
msgstr "“ není připravené menu. Vyberte menu s odkazy ve Vzhled → Menu, uložte ho a znovu načtěte tento editor.</p>"

msgid "<p class=\"aiwp-menu-preview-notice\">No menu is assigned to “"
msgstr "<p class=\"aiwp-menu-preview-notice\">Pro umístění „"

msgid "Primary menu"
msgstr "Hlavní menu"

msgid "Footer menu"
msgstr "Menu v patičce"

msgid "<button type=\"button\" class=\"aiwp-cookie-settings\" disabled title=\"Test consent controls on the website\">Cookie settings</button>"
msgstr "<button type=\"button\" class=\"aiwp-cookie-settings\" disabled title=\"Ovládání souhlasu vyzkoušejte na webu\">Nastavení cookies</button>"

msgid "Remove the ``` fences around the AI-generated code."
msgstr "Odstraňte značky ``` kolem kódu z odpovědi AI."

msgid "Remove the style and script wrapper tags from CSS and JS."
msgstr "Z CSS a JS odstraňte obalové značky style a script."

msgid "Keep only page content in HTML. Put CSS in the CSS tab and JavaScript in JS; remove document wrappers and metadata."
msgstr "V HTML ponechte jen obsah stránky. CSS patří do záložky CSS a JavaScript do JS; odstraňte obalové značky dokumentu a metadata."

msgid "PHP is not supported in the editor. Ask your AI for HTML, CSS and JavaScript."
msgstr "PHP do editoru nepatří. Nechte si od AI připravit HTML, CSS a JavaScript."

msgid "Then click Update or Publish. Previewing alone does not save changes."
msgstr "Potom klikněte na Aktualizovat nebo Publikovat. Samotný náhled změny neukládá."

msgid "Configure navigation in Appearance → Menus. "
msgstr "Odkazy nastavte přes Vzhled → Menu. "

msgid "The sample has been inserted and custom code is enabled. "
msgstr "Ukázka je vložená a použití vlastního kódu je zapnuté. "

msgid "<section class=\"moje-stranka\">\n  <div class=\"moje-stranka__obsah\">\n    <p class=\"moje-stranka__stitky\">YOUR NEW BEGINNING</p>\n    <h1>Great ideas start with a first page.</h1>\n    <p>Tell visitors what you do and how you can help them. Replace this text with your own story.</p>\n    <a class=\"moje-stranka__tlacitko\" href=\"#vice\">Learn more <span aria-hidden=\"true\">↗</span></a>\n  </div>\n  <div id=\"vice\" class=\"moje-stranka__karty\">\n    <article><span>01</span><h2>Your story</h2><p>What led you to what you do today?</p></article>\n    <article><span>02</span><h2>Your services</h2><p>Describe the specific help you offer.</p></article>\n    <article><span>03</span><h2>The next step</h2><p>Tell visitors how to get in touch.</p></article>\n  </div>\n</section>"
msgstr "<section class=\"moje-stranka\">\n  <div class=\"moje-stranka__obsah\">\n    <p class=\"moje-stranka__stitky\">VÁŠ NOVÝ ZAČÁTEK</p>\n    <h1>Velké nápady začínají první stránkou.</h1>\n    <p>Představte návštěvníkům, co děláte a s čím jim pomůžete. Tento text nahraďte vlastním příběhem.</p>\n    <a class=\"moje-stranka__tlacitko\" href=\"#vice\">Zjistit více <span aria-hidden=\"true\">↗</span></a>\n  </div>\n  <div id=\"vice\" class=\"moje-stranka__karty\">\n    <article><span>01</span><h2>Váš příběh</h2><p>Co vás přivedlo k tomu, co dnes děláte?</p></article>\n    <article><span>02</span><h2>Vaše služby</h2><p>Popište konkrétní pomoc, kterou nabízíte.</p></article>\n    <article><span>03</span><h2>Další krok</h2><p>Řekněte návštěvníkům, jak vás mohou kontaktovat.</p></article>\n  </div>\n</section>"

msgid "<div class=\"moje-cast\">\n  <a class=\"moje-cast__brand\" href=\"/\">Your website name</a>\n  <nav aria-label=\"Website navigation\">[aiwp_menu location=\""
msgstr "<div class=\"moje-cast\">\n  <a class=\"moje-cast__brand\" href=\"/\">Název vašeho webu</a>\n  <nav aria-label=\"Navigace webu\">[aiwp_menu location=\""

msgid "The sample will replace the current HTML, CSS and JavaScript in the editor. Continue? It will only be saved to the website when you click Update or Publish."
msgstr "Ukázka nahradí aktuální HTML, CSS a JavaScript v editoru. Pokračovat? Změna se na web uloží až tlačítkem Aktualizovat nebo Publikovat."

msgid "The menu marker has been inserted into HTML. Place it inside nav instead of the existing links. Enable custom code and save using Update."
msgstr "Značka menu je vložená do HTML. Umístěte ji dovnitř nav místo původních odkazů. Použití vlastního kódu musí být zapnuté; změny uložte tlačítkem Aktualizovat."

msgid "Prompt copied. Paste it into your AI and add your requirements."
msgstr "Zadání je zkopírované. Vložte ho do své AI a doplňte svou představu."

msgid "Copy the selected prompt using Ctrl+C (Cmd+C on Mac)."
msgstr "Označené zadání zkopírujte pomocí Ctrl+C (na Macu Cmd+C)."

msgid "Write the copy in the requested content language and mark where I need to add my own details. Include a proposed SEO title and meta description outside the code blocks."
msgstr "Texty napiš v požadovaném jazyce obsahu a označ místa, kde mám doplnit vlastní údaje. Připoj navržený SEO titulek a meta popis mimo bloky kódu."

msgid "Use the real image URLs supplied; if none are available, design without photographs. Do not invent functional forms, payment gateways or email delivery."
msgstr "Používej skutečné dodané URL obrázků; pokud chybějí, vytvoř vzhled bez fotografií. Nevymýšlej neexistující funkční formulář, platební bránu ani odesílání e-mailů."

msgid "The design must be responsive, readable and keyboard accessible. Provide sufficient contrast, control labels and support for prefers-reduced-motion."
msgstr "Návrh musí být responzivní, čitelný a přístupný z klávesnice. Dodrž kontrast, přidej popisy ovládání a respektuj prefers-reduced-motion."

msgid "JS is optional plain JavaScript without script tags, libraries or external scripts. Scope selectors to the fragment root, wrap the code in an IIFE and assume the DOM is loaded. Do not use PHP or call WordPress functions."
msgstr "JS je nepovinný čistý JavaScript bez značek script, bez knihoven a externích skriptů. Selektory omez na kořen fragmentu; kód uzavři do IIFE a počítej s načteným DOM. Nepoužívej PHP ani volání WordPress funkcí."

msgid " This marker produces ul.aiwp-menu with li.menu-item and a links, with ul.sub-menu for nested navigation. Adapt CSS to this structure and include accessible submenus. Do not write navigation links manually. [aiwp_cookie_settings] is also supported for footer cookie controls (button.aiwp-cookie-settings); it produces no output in external mode. Other shortcodes are not supported."
msgstr " Tato značka vytvoří ul.aiwp-menu s li.menu-item a odkazy a; případné podmenu je ul.sub-menu. CSS přizpůsob této struktuře a zahrň přístupné zobrazení podmenu. Odkazy ručně nevypisuj. Podporovaná je také značka [aiwp_cookie_settings] pro ovládání cookies v patičce (button.aiwp-cookie-settings); v externím režimu se nevypisuje. Další shortcody nejsou podporované."

msgid "If navigation is needed within the content, use [aiwp_menu location=\"primary\"] or [aiwp_menu location=\"footer\"]."
msgstr "Pokud potřebuji menu uvnitř obsahu, použij [aiwp_menu location=\"primary\"] nebo [aiwp_menu location=\"footer\"]."

msgid "Inside nav, insert exactly [aiwp_menu location=\""
msgstr "Do nav vlož přesně [aiwp_menu location=\""

msgid "I manage navigation in Appearance → Menus. "
msgstr "Menu spravuji přes Vzhled → Menu. "

msgid "Return CSS without style tags. Scope every selector to the fragment's unique root class; do not use global body, h1, button, etc. The variables --aiwp-accent, --aiwp-width and --aiwp-font are available."
msgstr "CSS vrať bez značek style. Všechny selektory omez na jedinečnou kořenovou třídu tohoto fragmentu; nepoužívej globální body, h1, button apod. K dispozici jsou proměnné --aiwp-accent, --aiwp-width a --aiwp-font."

msgid "I manage the header and footer separately; do not create them. Start with one main H1 heading; do not add another main element."
msgstr "Hlavičku a patičku spravuji zvlášť, nevytvářej je. Začni jedním hlavním nadpisem H1; nepřidávej další značku main."

msgid "Return only the requested header or footer."
msgstr "Vrať pouze požadovanou hlavičku nebo patičku."

msgid "HTML must be a content fragment: no doctype, html, head, body, style, script, PHP, on* attributes or javascript: URLs. "
msgstr "HTML je jen fragment obsahu: bez doctype, html, head, body, style, script, PHP, on* atributů a javascript: URL. "

msgid "Return exactly three separate sections labelled HTML, CSS and JS, which I will copy into separate fields."
msgstr "Vrať přesně tři oddělené části označené HTML, CSS a JS, které zkopíruji do samostatných polí."

msgid "My brief: [ADD the purpose, copy, colours, target audience and required sections]."
msgstr "Moje zadání: [DOPLŇ účel, texty, barvy, cílové publikum a požadované sekce]."

msgid " for WordPress with the ByYourself Theme theme and ByYourself Builder plugin."
msgstr " pro WordPress s šablonou ByYourself Theme a pluginem web-svepomoci-plugin."

msgid "page content"
msgstr "obsah stránky"

msgid "a shared header"
msgstr "společnou hlavičku"

msgid "a shared footer"
msgstr "společnou patičku"

msgid "Create "
msgstr "Vytvoř "

msgid "Do not add analytics, marketing scripts or a cookie banner to the page. Configure optional services in the selected consent manager: ByYourself → Privacy and cookies, or an external manager such as Complianz. Do not duplicate tracking code between managers."
msgstr "Nevkládej měření, marketingové skripty ani vlastní cookie lištu do stránky. Volitelné služby nastavuje zvolený správce souhlasu: ByYourself → Soukromí a cookies, nebo při externí správě například Complianz. Kódy mezi správci neduplikuj."

msgid "Custom code is disabled. You can preview it, but it will not appear on the website until you enable it and save."
msgstr "Použití vlastního kódu je vypnuté. Náhled ho může zobrazit, ale na web se neprojeví, dokud tuto volbu nezapnete a neuložíte."

msgid "Custom code is enabled. Save or publish to apply your changes to the website."
msgstr "Použití vlastního kódu je zapnuté. Změny se na web projeví po uložení nebo publikování."

msgid "Save your changes in WordPress."
msgstr "Změny uložte ve WordPressu."

msgid "Content has changed. Refresh the preview."
msgstr "Obsah se změnil. Obnovte náhled."

msgid "Your choice could not be saved. Allow necessary cookies in your browser; optional services will remain off."
msgstr "Volbu se nepodařilo uložit. Povolte nezbytné cookies v prohlížeči; volitelné služby se nezapnou."

msgid "Automatic copying is unavailable. The prompt is selected; press Ctrl+C (⌘C on Mac)."
msgstr "Automatické kopírování není dostupné. Zadání je označené; stiskněte Ctrl+C (na Macu ⌘C)."

msgid "Prompt copied. Paste it into your AI chat."
msgstr "Zadání je zkopírované. Vložte ho do chatu s AI."

msgid "The prompt could not be prepared. Try again."
msgstr "Zadání se nepodařilo připravit. Zkuste to znovu."

msgid "Your prompt is ready below. Review it and click Copy prompt."
msgstr "Zadání je připravené níže. Prohlédněte si ho a klikněte na Zkopírovat zadání."

msgid "Open editor"
msgstr "Otevřít editor"

msgid "The editor link could not be prepared. Reload the page and try again."
msgstr "Odkaz do editoru se nepodařilo připravit. Obnovte stránku a zkuste to znovu."

msgid "Preparing a prompt from saved information…"
msgstr "Připravuji zadání z uložených údajů…"

msgid "Click Search pages, then select a page from the list."
msgstr "Klikněte na Vyhledat stránky a potom vyberte stránku ze seznamu."

msgid "Search for a page first"
msgstr "Nejprve vyhledejte stránku"

msgid "Pages could not be loaded. Try again."
msgstr "Stránky se nepodařilo načíst. Zkuste to znovu."

msgid "Select a page from the list. Its code will only be added when you generate the prompt."
msgstr "Vyberte stránku ze seznamu. Její kód přidáme až při přípravě zadání."

msgid "Showing the first 20 pages. Refine your title search to find other pages."
msgstr "Zobrazuje se prvních 20 stránek. Pro další stránky zpřesněte hledání podle názvu."

msgid "No available pages match your search. Try a different title."
msgstr "Žádná dostupná stránka neodpovídá hledání. Zkuste jiný název."

msgid "The page list could not be loaded. Try searching again."
msgstr "Seznam stránek se nepodařilo načíst. Zkuste vyhledávání znovu."

msgid "Loading pages…"
msgstr "Načítám stránky…"

msgid "Select a page"
msgstr "Vyberte stránku"

msgid "The request could not be completed. Reload the page and try again."
msgstr "Požadavek se nepodařilo dokončit. Obnovte stránku a zkuste to znovu."

msgid "WordPress did not return a response. Reload the page and try again."
msgstr "WordPress nevrátil odpověď. Obnovte stránku a zkuste to znovu."

msgid "Select a page and describe the change. The prompt includes its currently saved code. Paste the AI response back into that page's HTML, CSS and JavaScript fields; check the preview before saving."
msgstr "Vyberte stránku a popište změnu. Zadání zahrne její současný uložený kód. Odpověď od AI vložíte zpět do HTML, CSS a JavaScriptu této stránky; před uložením zkontrolujete náhled."

msgid "AI will prepare a footer using the shared design and saved Footer code. Paste the result into the HTML, CSS and JavaScript fields under Footer. Manage links in Appearance → Menus."
msgstr "AI připraví patičku podle společného vzhledu a uloženého kódu Footeru. Výsledek vložíte do HTML, CSS a JavaScriptu v položce Footer. Odkazy se spravují ve Vzhled → Menu."

msgid "AI will prepare a header using the shared design and saved Header code. Paste the result into the HTML, CSS and JavaScript fields under Header. Manage links in Appearance → Menus."
msgstr "AI připraví hlavičku podle společného vzhledu a uloženého kódu Headeru. Výsledek vložíte do HTML, CSS a JavaScriptu v položce Header. Odkazy se spravují ve Vzhled → Menu."

msgid "AI will prepare a new page using your saved shared design. Create a WordPress page and paste its HTML, CSS and JavaScript into the corresponding AI editor fields."
msgstr "AI připraví novou stránku podle uloženého společného vzhledu. Ve WordPressu pak vytvoříte stránku a její HTML, CSS a JavaScript vložíte do odpovídajících polí AI editoru."

msgid "AI will propose shared CSS, including clamp() font sizes and line heights for H1–H6, body text and small. Paste the result into Website design → Shared CSS."
msgstr "AI navrhne společné CSS včetně velikostí písma a výšek řádků pomocí clamp() pro H1–H6, běžný text a small. Výsledek vložíte do Vzhled webu → Společné CSS."

msgid "Prompt copied. Paste it into your AI, put the resulting CSS in Shared CSS and save the website design."
msgstr "Zadání je zkopírované. Vložte je do AI, výsledné CSS vložte do Společného CSS a uložte vzhled webu."

msgid "Copy the prompt using Ctrl+C (Cmd+C on Mac). It reflects the current form values."
msgstr "Zadání zkopírujte pomocí Ctrl+C (na Macu Cmd+C). Odpovídá aktuálním hodnotám formuláře."

msgid "Currently empty."
msgstr "Zatím prázdné."

msgid "Current shared CSS:\n"
msgstr "Současné společné CSS:\n"

msgid "Return ONE complete CSS block without style tags, ready for Website design → Shared CSS. Do not create HTML or JS. Preserve existing CSS and incorporate changes; do not return just an addition. Outside the code, briefly explain the type scale and checks for mobile screens and enlarged text."
msgstr "Vrať JEDEN úplný blok CSS bez značek style, který vložím do Vzhled webu → Společné CSS. Nevytvářej HTML ani JS. Stávající CSS zachovej a zapracuj úpravy; nevracej jen doplněk. Mimo kód stručně popiš stupnici a kontrolu na mobilu a při zvětšení textu."

msgid "Design shared reusable .aiwp-button and .aiwp-card classes with accessible focus states. Do not change existing classes or functionality without explaining why. Shared selectors must not affect unrelated website elements."
msgstr "Navrhni společné opakovaně použitelné třídy .aiwp-button a .aiwp-card včetně přístupného focusu. Neměň existující třídy ani funkce bez vysvětlení. Společné selektory nesmějí zasahovat do cizích částí webu."

msgid "My brief: [ADD the website purpose, target audience and visual style]."
msgstr "Moje zadání: [DOPLŇ účel webu, cílovou skupinu a náladu vzhledu]."

msgid " (--aiwp-accent). Content width: "
msgstr " (--aiwp-accent). Šířka obsahu: "

msgid "Accent colour: "
msgstr "Hlavní barva: "

msgid ". Use var(--aiwp-font)."
msgstr ". Používej var(--aiwp-font)."

msgid "Selected font: "
msgstr "Zvolený font: "

msgid "Create shared CSS for a website using the ByYourself Theme theme and ByYourself Builder plugin."
msgstr "Vytvoř společné CSS pro web se šablonou ByYourself Theme a pluginem web-svepomoci-plugin."

msgid "Search engines may choose a different title or description. If you use a supported SEO plugin, manage metadata there — ByYourself Builder will let it output the metadata."
msgstr "Vyhledávače mohou zvolit jiný titulek nebo popis. Pokud používáte podporovaný SEO plugin, metadata spravujte v něm — ByYourself Builder mu přenechá jejich výpis."

msgid "The page remains publicly accessible. This setting does not password-protect it."
msgstr "Stránka zůstane veřejně dostupná. Toto nastavení ji nechrání heslem."

msgid "Ask search engines not to index this page (noindex)"
msgstr "Požádat vyhledávače, aby tuto stránku neindexovaly (noindex)"

msgid "Fill this in only if search engines should treat another URL as the primary version of the same content."
msgstr "Vyplňte pouze, pokud má vyhledávač považovat jinou adresu za hlavní verzi stejného obsahu."

msgid "Automatic: this page's URL"
msgstr "Automaticky: adresa této stránky"

msgid "Canonical URL"
msgstr "Kanonická URL"

msgid "Advanced settings"
msgstr "Pokročilé nastavení"

msgid "Image URL for social link previews. Paste a URL or choose an image from the library."
msgstr "Adresa obrázku pro náhled odkazu na sociálních sítích. Můžete vložit URL nebo vybrat obrázek z knihovny."

msgid "Choose from media"
msgstr "Vybrat z médií"

msgid "Sharing image"
msgstr "Obrázek pro sdílení"

msgid "characters · Briefly describe the page's value. Around 140–160 characters is a useful starting point, not a fixed limit."
msgstr "znaků · Stručně popište přínos stránky. Přibližně 140–160 znaků je dobrý výchozí bod, nikoli pevný limit."

msgid "characters · Around 50–60 characters is often useful; put the main message first."
msgstr "znaků · Obvykle se hodí přibližně 50–60 znaků; nejdůležitější sdělení dejte na začátek."

msgid "Help people understand what the page contains. An empty SEO title uses the page title."
msgstr "Pomozte lidem poznat, co na stránce najdou. Prázdný SEO titulek se doplní z názvu stránky."

msgid "<p>SEO settings in ByYourself Builder are managed by the website administrator.</p>"
msgstr "<p>Nastavení SEO v pluginu ByYourself Builder upravuje správce webu.</p>"

msgid "Enable JavaScript in your browser for syntax highlighting, tabs and previews. Without it, you can still paste code into the three text fields and save."
msgstr "Pro zvýraznění kódu, přepínání záložek a náhled zapněte JavaScript v prohlížeči. Kód lze i bez něj vložit do tří textových polí a uložit."

msgid "in WordPress. Previously saved versions are available in revisions."
msgstr "ve WordPressu. Předchozí uložené verze najdete v revizích."

msgid "Save draft"
msgstr "Uložit koncept"

msgid "Finished? Use"
msgstr "Hotovo? Použijte"

msgid "Useful for a standalone landing page, for example. This option is supported by the ByYourself Theme theme."
msgstr "Vhodné například pro samostatnou prodejní stránku. Tuto volbu podporuje šablona web-svepomoci-sablona."

msgid "Hide shared footer"
msgstr "Skrýt společnou patičku"

msgid "Hide shared header"
msgstr "Skrýt společnou hlavičku"

msgid "Page layout"
msgstr "Rozložení této stránky"

msgid "This preview does not save changes. It only displays the content currently being edited; links, forms and external scripts are restricted. To preview the whole website, save a draft or update the page, then use WordPress Preview."
msgstr "Tento náhled neukládá změny. Zobrazuje jen právě upravovaný obsah; odkazy, formuláře a externí skripty jsou omezené. Pro náhled celého webu nejprve uložte koncept nebo aktualizujte stránku a pak použijte tlačítko Náhled ve WordPressu."

msgid "Isolated preview of the entered content"
msgstr "Izolovaný náhled právě vloženého obsahu"

msgid "After pasting the code, click “Refresh preview”."
msgstr "Po vložení kódu klikněte na „Obnovit náhled“."

msgid "Your design will appear here"
msgstr "Tady uvidíte svůj návrh"

msgid "Refresh preview"
msgstr "Obnovit náhled"

msgid "Desktop"
msgstr "Počítač"

msgid "Preview width"
msgstr "Šířka náhledu"

msgid "Ready for the first preview."
msgstr "Připraveno k prvnímu náhledu."

msgid "Content preview"
msgstr "Náhled obsahu"

msgid "Paste the code itself without ``` fences."
msgstr "Vkládejte samotný kód bez ohraničení ```."

msgid " code"
msgstr " kód"

msgid "Optional. Insert JavaScript without <script> tags. For a simple page with text and images, this field can stay empty."
msgstr "Nepovinné. Vložte JavaScript bez značek <script>. Pro běžnou stránku s texty a obrázky může toto pole zůstat prázdné."

msgid "Insert CSS without <style> tags. Use your own classes, such as .moje-stranka, to avoid affecting other website elements."
msgstr "Vložte CSS bez značek <style>. Použijte vlastní třídy, například .moje-stranka, aby se vzhled neprolínal s ostatními částmi webu."

msgid "Insert only page content, such as sections, headings and paragraphs. No html, head, body, style or script tags. PHP is not supported."
msgstr "Vložte pouze obsah stránky, například sekce, nadpisy a odstavce. Bez značek html, head, body, style a script. PHP se nevkládá."

msgid "This field contains code"
msgstr "Pole obsahuje kód"

msgid "Behaviour"
msgstr "Chování"

msgid "Code type"
msgstr "Druh kódu"

msgid "Custom code is disabled. Enable it and save the page to show it on the website."
msgstr "Použití vlastního kódu je vypnuté. Pro zobrazení na webu ho zapněte a stránku uložte."

msgid "” yet. Select and save a menu in Appearance → Menus first; links will not appear until then."
msgstr "“ zatím není přiřazené menu. Nejdříve ho vyberte a uložte ve Vzhled → Menu; do té doby se odkazy na webu nezobrazí."

msgid "No menu is assigned to “"
msgstr "K umístění „"

